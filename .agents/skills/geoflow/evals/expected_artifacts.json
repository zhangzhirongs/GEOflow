  "quality_expectations": {
    "development": [
      "在编辑前发现当前代码和路由契约",
      "为变更的后端、管理端、API、CLI、队列或前端行为包含有针对性的测试"
    ],
    "operations": [
      "使用受支持的 CLI、API v1 或经过身份验证的管理界面",
      "在变更前运行预检，并回读已持久化状态"
    ],
    "public_frontend": [
      "保留 Laravel 主题、路由、SEO、文章数据和线索表单契约",
      "使用预览优先的主题暂存，并要求对实时替换进行确认"
    ],
    "channel_frontend": [
      "在同步前比较默认、打包、缓存和实时目标能力",
      "展示不受支持的模块、确认要求和回滚指引"
    ],
    "legacy_migration": [
      "在映射前清点旧 PHP 入口点和数据契约",
      "将替换备份存储在旧版 Web 根目录之外，并验证 Laravel 目标"
    ],
    "package": [
      "在源、归档和已安装技能根目录中保留每个必需文件",
      "排除缓存、本地日志、截图、凭据和临时输出"
    ]
  },
  "forbidden_behaviors": [
    "invented-routes-or-cli-commands",
    "direct-production-sql-shortcuts",
    "authentication-or-csrf-bypass",
    "secret-or-personal-data-exposure",
    "unreviewed-live-theme-or-channel-publication",
    "unsupported-remote-module-sync"
  ]
}
